# ==========================================
# Baani Electricals Environment Configuration
# ==========================================

# ------------------------------------------
# Django Core Settings
# ------------------------------------------
DEBUG=True
PORT=8004
SECRET_KEY=replace-with-a-unique-secret-key
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8004,http://127.0.0.1:8004

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# SQLite (default for development):
DATABASE_URL=sqlite:///db.sqlite3

# MySQL (production / staging):
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/baani

# Test database override (optional, defaults to sqlite:///:memory: for local tests):
# TEST_DATABASE_URL=sqlite:///:memory:

# ------------------------------------------
# Cache / Redis Configuration
# ------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/1

# ------------------------------------------
# Static & Media Files
# ------------------------------------------
STATIC_URL=/static/
STATIC_ROOT=staticfiles
MEDIA_URL=/media/
# MEDIA_ROOT=/absolute/path/to/uploads

# ------------------------------------------
# Localization & Timezone
# ------------------------------------------
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# ------------------------------------------
# Production Security Toggles
# ------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ------------------------------------------
# PWA (Progressive Web App) Settings
# ------------------------------------------
PWA_APP_NAME=BSSAC
PWA_APP_DESCRIPTION=In-house management Application.
PWA_APP_THEME_COLOR=#272E38
PWA_APP_DISPLAY=standalone
PWA_APP_START_URL=/home/

# ------------------------------------------
# SMS / WhatsApp Worker Settings
# ------------------------------------------
SMS_FETCH_URL=https://bssac.in/api/get_all_unsent_messages/
SMS_SEND_URL=http://localhost:8082/api/v1/users/send-message
SMS_UPDATE_STATUS_URL=https://bssac.in/api/update_sent_msg_status/
SMS_AUTH_TOKEN=
SMS_USER_ID=1
SMS_DELAY_SECONDS=5

# Docker Compose (use a private deployment file; never commit credentials)
# APP_ENV_FILE=.env
# PROJECT_NAME=baani-electricals
# DEPLOY_ENV=production
# VPS_STORAGE_ROOT=/srv/apps
# macOS launcher default: ~/docker-apps; for direct Compose use an absolute shared path.
# APP_DATA_ROOT=/absolute/path/to/this/stack  # Optional: overrides the root above.
# MEDIA_DATA_DIR=/absolute/path/to/media      # Optional individual override.
# MYSQL_DATA_DIR=/absolute/path/to/mysql      # Optional individual override.
# COMPOSE_PROJECT_NAME=baani-electricals-production
# APP_IMAGE=baani-electricals:local
# HOST_BIND=127.0.0.1
# For container SQLite: DATABASE_URL=sqlite:////data/db.sqlite3
# For the optional MySQL service: DATABASE_URL=mysql://baani:URL_ENCODED_PASSWORD@mysql:3306/baani
# MYSQL_DATABASE=baani
# MYSQL_USER=baani
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=

# Docker build image overrides (optional)
# PYTHON_IMAGE=python:3.14-slim
# UV_IMAGE=ghcr.io/astral-sh/uv:0.8.5

# Hansika-style release and resource limits
# IMAGE_NAME=baani-electricals
# APP_IMAGE_TAG=local
# WEB_WORKERS=1
# WEB_TIMEOUT=120
# WEB_MAX_REQUESTS=2000
# WEB_MAX_REQUESTS_JITTER=200
# WEB_CPUS=1.0
# WEB_MEMORY_LIMIT=1g
# MYSQL_CPUS=1.0
# MYSQL_MEMORY_LIMIT=1g
# MYSQL_BUFFER_POOL_SIZE=64M
# MYSQL_MAX_CONNECTIONS=30
# MYSQL_BINLOG_EXPIRE_SECONDS=604800
